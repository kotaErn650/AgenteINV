<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:AgenteINV.ViewModels"
             xmlns:models="clr-namespace:AgenteINV.Models"
             x:Class="AgenteINV.Views.CategoriasPage"
             x:DataType="viewModels:CategoriasViewModel"
             Title="{Binding Title}">

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="20">
        <VerticalStackLayout Spacing="12">
            <Label Text="Administrar categorías" FontSize="24" FontAttributes="Bold" />
            <Entry Text="{Binding CurrentCategoria.Nombre}" Placeholder="Nombre de la categoría" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Button Text="Guardar" Command="{Binding SaveCommand}" Grid.Column="0" HorizontalOptions="Fill" />
                <Button Text="Nuevo" Command="{Binding NewCommand}" Grid.Column="1" HorizontalOptions="Fill" />
                <Button Text="Eliminar" Command="{Binding DeleteCommand}" Grid.Column="2" HorizontalOptions="Fill" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categorias}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCategoria}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Categoria">
                    <Border Margin="0,0,0,12" Padding="14" StrokeThickness="1">
                        <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
