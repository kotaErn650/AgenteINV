<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:AgenteINV.ViewModels"
             xmlns:models="clr-namespace:AgenteINV.Models"
             x:Class="AgenteINV.Views.ProveedoresPage"
             x:DataType="viewModels:ProveedoresViewModel"
             Title="{Binding Title}">

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="20">
        <VerticalStackLayout Spacing="12">
            <Label Text="Administrar proveedores" FontSize="24" FontAttributes="Bold" />
            <Entry Text="{Binding CurrentProveedor.Nombre}" Placeholder="Nombre" />
            <Entry Text="{Binding CurrentProveedor.Contacto}" Placeholder="Contacto" />
            <Entry Text="{Binding CurrentProveedor.Direccion}" Placeholder="Dirección" />
            <Label Text="{Binding StatusMessage}" TextColor="#B42318" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Button Text="Guardar" Command="{Binding SaveCommand}" Grid.Column="0" HorizontalOptions="Fill" />
                <Button Text="Nuevo" Command="{Binding NewCommand}" Grid.Column="1" HorizontalOptions="Fill" />
                <Button Text="Eliminar" Command="{Binding DeleteCommand}" Grid.Column="2" HorizontalOptions="Fill" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Proveedores}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedProveedor}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Proveedor">
                    <Border Margin="0,0,0,12" Padding="14" StrokeThickness="1">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                            <Label Text="{Binding Contacto}" />
                            <Label Text="{Binding Direccion}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
