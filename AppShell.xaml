<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="AgenteINV.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AgenteINV.Views"
       Title="AgenteINV">

    <FlyoutItem Title="Dashboard" FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent Title="Productos"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:ProductosPage}"
                      Route="ProductosPage" />
        <ShellContent Title="Categorías"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:CategoriasPage}"
                      Route="CategoriasPage" />
        <ShellContent Title="Proveedores"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate views:ProveedoresPage}"
                      Route="ProveedoresPage" />
    </FlyoutItem>
</Shell>
